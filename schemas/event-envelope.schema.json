{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.n0ding.dev/event-envelope.schema.json",
  "title": "n0ding event envelope",
  "description": "Versioned, append-only observation shared by Bench and Dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "occurred_at",
    "recorded_at",
    "source",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload_schema": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 512
    },
    "payload": {
      "type": "object"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "component"],
      "properties": {
        "product": {
          "const": "dispatch"
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["run", "case", "attempt", "task", "agent", "message", "artifact", "action", "approval"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
